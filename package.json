{
  "name": "tracker-cloudfront",
  "version": "0.1.0",
  "description": "AWS Lambda to ingest CloudFront logs and send hits to Matomo",
  "license": "BSD-3-Clause",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "parse:log": "tsx scripts/parse.ts",
    "build": "esbuild src/index.ts --bundle --minify --platform=node --target=node24 --format=cjs --outdir=dist"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.731.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^4.0.14",
    "esbuild": "^0.27.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.9.3",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.0.14"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "fsevents@2.3.3": true
  }
}
